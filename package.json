{
  "name": "tg-ki-im-service",
  "version": "0.1.0",
  "private": true,
  "description": "Arbeitsplattform der Themengruppe „KI im Service“: E2E-Serviceprozess (SAP-Standard, In-House Service) als BPMN, SAP-Agenten (Autonomous Service), Agentenlücken, Anforderungsportal der Unternehmen, Prozess-, User-Story- und Abgleich-Agent.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:static": "vite build --mode static",
    "build:artifact": "vite build --mode artifact && tsx scripts/inline-artifact.ts",
    "start": "tsx src/server/index.ts",
    "mcp": "tsx src/mcp/tg-server.ts",
    "validate": "tsx scripts/validate.ts",
    "docs": "tsx scripts/gen-docs.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bpmn-js": "^18.31.0",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
