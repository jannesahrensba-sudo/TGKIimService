<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_E2E" targetNamespace="urn:tg-ki-im-service:bpmn:E2E" exporter="TG KI im Service – Arbeitsplattform" exporterVersion="0.1">
  <bpmn:collaboration id="Collaboration_E2E">
    <bpmn:participant id="Participant_Kunde" name="Kunde" />
    <bpmn:participant id="Participant_Main" name="E2E Serviceprozess End-to-End (SAP-Standard heute, mit In-House Service)" processRef="Process_E2E" />
    <bpmn:messageFlow id="Msg_in_E01" name="Störung / Anfrage" sourceRef="Participant_Kunde" targetRef="E01" />
    <bpmn:messageFlow id="Msg_in_E13" name="Gerät wird eingesendet" sourceRef="Participant_Kunde" targetRef="E13" />
    <bpmn:messageFlow id="Msg_in_E19" name="Annahme / Ablehnung" sourceRef="Participant_Kunde" targetRef="E19" />
    <bpmn:messageFlow id="Msg_out_E07" name="Lösung / Antwort" sourceRef="E07" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_out_E12" name="Rücksendeinformation" sourceRef="E12" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_out_E18" name="Angebot" sourceRef="E18" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_out_E26" name="Gerät zurück" sourceRef="E26" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_out_F04" name="Termin / ETA" sourceRef="F04" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_out_B01" name="Rechnung" sourceRef="B01" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_out_C01" name="Abschluss &amp; Feedbackanfrage" sourceRef="C01" targetRef="Participant_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_E2E" name="E2E Serviceprozess End-to-End (SAP-Standard heute, mit In-House Service)" isExecutable="false">
    <bpmn:documentation>Ganzheitlicher Serviceprozess vom ersten Kundenkontakt bis zum finanziellen Abschluss, wie ihn SAP heute im Standard abbildet: SAP Service Cloud V2 (Case Management), SAP S/4HANA Service (Garantie/Vertrag, Angebot, Serviceauftrag, In-House Service, Rückmeldung, Faktura), S/4HANA-Logistik (Retoure, Wareneingang, Auslieferung) und SAP Field Service Management (Disposition, mobile Durchführung). Die In-House-Strecke folgt In-House Service 2.0 (ab 2023 FPS02, Begriffe ab Release 2025).
Abgrenzung: Reaktiver Service (Störung/Anfrage) mit zwei Abwicklungsarten: In-House Service (Gerät wird eingesendet) und Field Service (Einsatz vor Ort). Nicht im Detail: Serviceverträge/Wartungsplanung, Service with Advanced Execution (EAM), Intercompany – als Hinweise an den Schritten.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_E2E">
      <bpmn:lane id="Lane_L_CS" name="Kundenservice">
        <bpmn:flowNodeRef>E01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_DONE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L_SALES" name="Service-Vertrieb">
        <bpmn:flowNodeRef>E18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E19</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L_PLAN" name="Serviceplanung">
        <bpmn:flowNodeRef>E10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E20J</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L_DISP" name="Disposition">
        <bpmn:flowNodeRef>F03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L_LOG" name="Logistik &amp; Wareneingang">
        <bpmn:flowNodeRef>E13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E26J</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L_TECH" name="Techniker (Werkstatt &amp; vor Ort)">
        <bpmn:flowNodeRef>E22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L_FIN" name="Fakturierung &amp; Finanzen">
        <bpmn:flowNodeRef>G_BILL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CHG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B02</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E01" name="Kundenanliegen geht ein">
      <bpmn:documentation>Kunde meldet Störung oder Anfrage über Telefon, E-Mail, Chat oder Portal.
Systeme: SAP Service Cloud V2, Kundenportal / Self-Service
SAP-Agenten: Digital Service Agent (LAB_PREVIEW)
Objekte: Interaktion
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:outgoing>Flow_f01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E01_def" />
    </bpmn:startEvent>
    <bpmn:startEvent id="E02" name="Zustandsmeldung (IoT / Monitoring)">
      <bpmn:documentation>Zustandsbasierte Meldung aus IoT- oder Monitoringdaten (Condition-based Monitoring) löst einen Case bzw. eine Serviceanfrage aus.
Systeme: SAP Service Cloud V2
SAP-Agenten: Service Notification Initiation Agent (LAB_PREVIEW)
Objekte: Meldung, Messwerte
Hinweis: Kanal IoT laut V128 (Customer Service) und „Condition based monitoring“ (Kick-off). Konkretes Integrationsszenario je Produkt prüfen.
Marker: SAP-Folien (TG)</bpmn:documentation>
      <bpmn:outgoing>Flow_f02</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E02_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="E03" name="Interaktion erfassen, Kunde &amp; Equipment identifizieren">
      <bpmn:documentation>Service Agent erfasst die Interaktion im Customer Hub, identifiziert Kunde, Ansprechpartner und betroffenes Equipment (registriertes Produkt) und sieht die Historie.
Systeme: SAP Service Cloud V2
SAP-Agenten: Case Preparation Agent (LAB_PREVIEW), Sentiment / Topic Agent (LAB_PREVIEW), Equipment Insights Agent (LAB_PREVIEW), Equipment Enrichment Agent (LAB_PREVIEW)
Objekte: Interaktion, Geschäftspartner, Equipment / Registriertes Produkt
Apps: Customer Hub (Service Cloud V2)
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f01</bpmn:incoming>
      <bpmn:outgoing>Flow_f03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E04" name="Case anlegen, klassifizieren &amp; priorisieren">
      <bpmn:documentation>Case mit Kategorie, Priorität und SLA anlegen; Routing an das zuständige Team. Case-Kategorisierung kann aus historischen Cases gelernt werden.
Systeme: SAP Service Cloud V2
SAP-Agenten: Case Classification Agent (VERFUEGBAR), Case Preparation Agent (LAB_PREVIEW), Case Processing Agent (LAB_PREVIEW), Escalation Agent (LAB_PREVIEW), Sentiment / Topic Agent (LAB_PREVIEW)
Objekte: Case, SLA
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f02</bpmn:incoming>
      <bpmn:incoming>Flow_f03</bpmn:incoming>
      <bpmn:outgoing>Flow_f04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E05" name="Lösung recherchieren (Wissen, Historie, Garantie)">
      <bpmn:documentation>Wissensdatenbank, Case- und Gerätehistorie sowie Garantie-/Vertragsstatus prüfen; Antwort an den Kunden vorbereiten.
Systeme: SAP Service Cloud V2
SAP-Agenten: Case Summary (Joule) (VERFUEGBAR), Q&amp;A Agent (VERFUEGBAR), Case Processing Agent (LAB_PREVIEW), Case Action Recommendation Agent (LAB_PREVIEW), Knowledge Content Retrieval Agent (LAB_PREVIEW), Coaching Agent (LAB_PREVIEW)
Objekte: Wissensartikel, Case-Historie
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f04</bpmn:incoming>
      <bpmn:outgoing>Flow_f05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E06" name="Remote lösbar?" default="Flow_f07">
      <bpmn:documentation>Kann das Anliegen ohne Serviceeinsatz gelöst werden?
SAP-Agenten: Case Action Recommendation Agent (LAB_PREVIEW)
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f05</bpmn:incoming>
      <bpmn:outgoing>Flow_f06</bpmn:outgoing>
      <bpmn:outgoing>Flow_f07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="E07" name="Lösung mitteilen &amp; Case lösen">
      <bpmn:documentation>Antwort bzw. Lösung an den Kunden senden, Case auf gelöst setzen.
Systeme: SAP Service Cloud V2
SAP-Agenten: Knowledge Creation Agent (VERFUEGBAR), Digital Service Agent (LAB_PREVIEW), Compliance Agent (LAB_PREVIEW)
Objekte: Case, E-Mail
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f06</bpmn:incoming>
      <bpmn:outgoing>Flow_f08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E08" name="Anliegen gelöst (First Contact Resolution)">
      <bpmn:documentation>Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="E09" name="Serviceeinsatz anstoßen (Folgebeleg in S/4HANA Service)">
      <bpmn:documentation>Aus dem Case wird der Folgebeleg in S/4HANA Service vorbereitet (Serviceanfrage oder Serviceauftrag) – inkl. Kunde, Equipment, Schadensbild.
Systeme: SAP Service Cloud V2, SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Service Order Preparation Agent (LAB_PREVIEW), Service Notification Initiation Agent (LAB_PREVIEW)
Objekte: Case, Serviceanfrage, Serviceauftrag
Hinweis: Integrationsszenario Service Cloud V2 → S/4HANA Service (Folgebeleg aus Case) für die Zielrelease prüfen.
Marker: Zu verifizieren</bpmn:documentation>
      <bpmn:incoming>Flow_f07</bpmn:incoming>
      <bpmn:outgoing>Flow_f09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="E10" name="Garantie &amp; Vertrag prüfen (Entitlement)">
      <bpmn:documentation>Garantiefindung (Garantie-Prüfprofil, Mastergarantie am Equipment; ab 2025 FPS0 auch abgelaufene/datumsbasierte Garantien und Übersteuern) und Servicevertragsfindung (Auftraggeber, VkOrg/VtWeg, Gültigkeit) – bestimmt Kostenpflicht und Konditionen.
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Warranty Coverage Check Agent (LAB_PREVIEW), Service Contract Performance Agent (LAB_PREVIEW)
Objekte: Garantie, Servicevertrag, Equipment
Scope Items: 426 / 3MO (Serviceverträge)
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f09</bpmn:incoming>
      <bpmn:outgoing>Flow_f10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="E11" name="Abwicklungsart?">
      <bpmn:documentation>In-House Service (Gerät wird eingesendet) oder Einsatz vor Ort (Field Service).
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f10</bpmn:incoming>
      <bpmn:outgoing>Flow_f11</bpmn:outgoing>
      <bpmn:outgoing>Flow_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E12" name="Retourenauftrag &amp; In-House Service anlegen">
      <bpmn:documentation>Retourenauftrag mit Folgeaktivität „In-House Service fortführen“ und In-House Service mit Serviceobjekten anlegen (Massenaktionen möglich). Alternative: In-House Service entsteht automatisch beim Wareneingang/Prüfung oder beim Sichern eines Angebots mit Serviceobjekt.
Systeme: SAP S/4HANA Service (Cloud ERP), SAP S/4HANA Logistik
SAP-Agenten: In-House Service Processing Agent (GEPLANT), In-house service initiation (KI-Funktion) (VERFUEGBAR)
Objekte: Retourenauftrag, In-House Service, Serviceobjekt
Apps: Manage In-House Services, Manage In-House Service Objects
Scope Items: 3XK (Public Cloud)
Hinweis: Fiori-App-IDs (F7695 / F4025) in den Quellen widersprüchlich – im Fiori Apps Reference Library prüfen.
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f11</bpmn:incoming>
      <bpmn:outgoing>Flow_f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="E13" name="Gerät empfangen &amp; Wareneingang buchen">
      <bpmn:documentation>Shipping Specialist bucht den Wareneingang zum Retourenauftrag; Kundenretouren können auf Kundensonderbestand gebucht werden (2025). Serviceobjekt: „Received by Service Center“.
Systeme: SAP S/4HANA Logistik
SAP-Agenten: In-House Service Processing Agent (GEPLANT), In-house service initiation (KI-Funktion) (VERFUEGBAR)
Objekte: Retourenlieferung, Wareneingang, Kundensonderbestand
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f13</bpmn:incoming>
      <bpmn:outgoing>Flow_f14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="E14" name="Eingangsprüfung (Inspection)">
      <bpmn:documentation>Receiving Specialist prüft das Gerät; mit „Material Received“ und Prüfergebnis legt das System den In-House Service automatisch an. Transfer an ein anderes Service Center (auch Intercompany ab 2025 FPS1) möglich.
Systeme: SAP S/4HANA Logistik, SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Equipment Enrichment Agent (LAB_PREVIEW), In-House Service Processing Agent (GEPLANT)
Objekte: Prüfergebnis, Serviceobjekt
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f14</bpmn:incoming>
      <bpmn:outgoing>Flow_f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E15" name="Vorprüfung (Precheck) je Serviceobjekt">
      <bpmn:documentation>Je Serviceobjekt entscheiden: reparieren oder unrepariert an den Kunden zurück (dann kein Serviceauftrag). Kostenpflichtige Diagnose möglich.
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Equipment Insights Agent (LAB_PREVIEW)
Objekte: Serviceobjekt
Apps: Perform Prechecks
Hinweis: Verschrottungs-/Austauschentscheidung als eigene Option in keiner Quelle gefunden (OFFEN).
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f15</bpmn:incoming>
      <bpmn:outgoing>Flow_f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E16" name="Ergebnis Vorprüfung?" default="Flow_f17">
      <bpmn:documentation>Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f16</bpmn:incoming>
      <bpmn:outgoing>Flow_f17</bpmn:outgoing>
      <bpmn:outgoing>Flow_f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="E17" name="Kostenpflichtig?" default="Flow_f20">
      <bpmn:documentation>Ergebnis der Garantie-/Vertragsprüfung.
SAP-Agenten: Warranty Coverage Check Agent (LAB_PREVIEW)
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f17</bpmn:incoming>
      <bpmn:outgoing>Flow_f19</bpmn:outgoing>
      <bpmn:outgoing>Flow_f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E18" name="Serviceangebot erstellen &amp; versenden">
      <bpmn:documentation>Serviceangebot (Festpreis oder Aufwand, mit Versionen) für die Serviceobjekte erstellen; ist ein Serviceobjekt enthalten, wird der In-House-Service-Beleg beim Sichern verknüpft bzw. angelegt.
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Service Quotation Optimization Agent (GEPLANT), Service Scope Recommendation Agent (LAB_PREVIEW), Service Sales Agent (LAB_PREVIEW)
Objekte: Serviceangebot, Festpreisvariante
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f19</bpmn:incoming>
      <bpmn:outgoing>Flow_f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E19" name="Angebot angenommen?" default="Flow_f22">
      <bpmn:documentation>SAP-Agenten: Service Quotation Optimization Agent (GEPLANT)
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f21</bpmn:incoming>
      <bpmn:outgoing>Flow_f22</bpmn:outgoing>
      <bpmn:outgoing>Flow_f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="E20J" name="">
      <bpmn:documentation>Zusammenführung
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f20</bpmn:incoming>
      <bpmn:incoming>Flow_f22</bpmn:incoming>
      <bpmn:outgoing>Flow_f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E20" name="Serviceauftrag (Reparatur) anlegen, planen &amp; freigeben">
      <bpmn:documentation>Je Serviceobjekt ein Serviceauftrag; Servicemitarbeiter, Termine und Ersatzteilpositionen planen, Auftrag freigeben. Alternative: Service with Advanced Execution (Ausführungsauftragsposition → abrechenbarer Instandhaltungsauftrag).
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Service Order Planning and Operations Agent (LAB_PREVIEW), Service Scope Recommendation Agent (LAB_PREVIEW), AI assisted Service Monitor (Operation Monitoring &amp; Resolution / Service Control Tower) (LAB_PREVIEW), Joule für Serviceaufträge (VERFUEGBAR), Service Template Agent (WIP)
Objekte: Serviceauftrag, Serviceauftragsvorlage
Apps: Manage Service Orders, Plan Repairs
Scope Items: 3XK, 3D2
Hinweis: App-Namen „Plan Repairs“/„Manage Service Orders“ je Release prüfen.
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f24</bpmn:incoming>
      <bpmn:outgoing>Flow_f25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="E21" name="Ersatzteile reservieren / beschaffen">
      <bpmn:documentation>Bei Freigabe entsteht für Ersatzteilpositionen automatisch eine Bestellanforderung bzw. Reservierung.
Systeme: SAP S/4HANA Service (Cloud ERP), SAP S/4HANA Logistik
SAP-Agenten: Service Order Planning and Operations Agent (LAB_PREVIEW), Parts Logistics Monitor / Advance Shipment Monitor (WIP)
Objekte: Reservierung, Bestellanforderung
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f25</bpmn:incoming>
      <bpmn:outgoing>Flow_f26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="E22" name="Reparatur in der Werkstatt durchführen">
      <bpmn:documentation>Techniker im Service Center führt die Reparatur am Serviceobjekt aus (Serviceauftrag in S/4HANA; Ausführung in EAM bei Advanced Execution).
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Technician Briefing Agent (LAB_PREVIEW), Work Execution Agent (LAB_PREVIEW)
Objekte: Serviceauftrag, Serviceobjekt
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f26</bpmn:incoming>
      <bpmn:outgoing>Flow_f27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E23" name="Zeiten &amp; Material rückmelden">
      <bpmn:documentation>Servicerückmeldung je Auftragsposition (Zeit, Ersatzteile, Spesen); Buchungen nach Controlling.
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Service Debriefing Agent (LAB_PREVIEW), Service Confirmation Agent (WIP)
Objekte: Servicerückmeldung
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f27</bpmn:incoming>
      <bpmn:outgoing>Flow_f28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E24" name="Abschließen &amp; zur Fakturierung freigeben">
      <bpmn:documentation>Rückmeldungen prüfen, Serviceauftrag abschließen (nur abgeschlossene Aufträge sind fakturierbar), Freigabe zur Fakturierung – erzeugt die Fakturaanforderung.
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Billing Orchestration Agent (LAB_PREVIEW), Warranty Claim Agent (WIP)
Objekte: Serviceauftrag, Fakturaanforderung
Apps: Prepare for Billing
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f28</bpmn:incoming>
      <bpmn:outgoing>Flow_f29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E26J" name="">
      <bpmn:documentation>Zusammenführung
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f18</bpmn:incoming>
      <bpmn:incoming>Flow_f23</bpmn:incoming>
      <bpmn:incoming>Flow_f29</bpmn:incoming>
      <bpmn:outgoing>Flow_f30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E26" name="Serviceobjekt zurücksenden (Auslieferung &amp; Warenausgang)">
      <bpmn:documentation>Auslieferung zum Retourenauftrag anlegen (z. B. über „Prepare for Billing“) und Warenausgang buchen; Retourenauftrag ohne Erstattung (No Refund) abschließen.
Systeme: SAP S/4HANA Logistik
SAP-Agenten: In-House Service Processing Agent (GEPLANT)
Objekte: Auslieferung, Warenausgang, Retourenauftrag
Apps: Prepare for Billing
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f30</bpmn:incoming>
      <bpmn:outgoing>Flow_f31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E27" name="Serviceobjekt &amp; In-House Service abschließen">
      <bpmn:documentation>Serviceobjekt auf „Abgeschlossen“ setzen; In-House Service beenden.
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: In-House Service Processing Agent (GEPLANT)
Objekte: Serviceobjekt, In-House Service
Apps: Manage In-House Service Objects
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f31</bpmn:incoming>
      <bpmn:outgoing>Flow_f32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="F01" name="Serviceauftrag anlegen &amp; freigeben">
      <bpmn:documentation>Serviceauftrag (ggf. aus Serviceanfrage, Angebot, Vorlage oder Vertrag) mit Positionen anlegen und freigeben.
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Service Order Planning and Operations Agent (LAB_PREVIEW), Joule für Serviceaufträge (VERFUEGBAR), Service Template Agent (WIP)
Objekte: Serviceauftrag, Serviceanfrage, Serviceauftragsvorlage
Apps: Manage Service Orders
Scope Items: 3D2
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f12</bpmn:incoming>
      <bpmn:outgoing>Flow_f33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="F02" name="Serviceauftrag an SAP FSM übertragen">
      <bpmn:documentation>Freigegebener Serviceauftrag wird an SAP Field Service Management repliziert (Scope Item 49X, Zusatzlizenz FSM).
Systeme: SAP S/4HANA Service (Cloud ERP), SAP Field Service Management
Objekte: Serviceauftrag, Service Call / Aktivität (FSM)
Scope Items: 49X
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f33</bpmn:incoming>
      <bpmn:outgoing>Flow_f34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="F03" name="Einsatz planen &amp; disponieren (Skills, Gebiet, Route)">
      <bpmn:documentation>Disponent plant Einsätze auf der Plantafel nach Qualifikation, Gebiet, Auslastung und Route; Techniker und Termin gehen an S/4HANA zurück.
Systeme: SAP Field Service Management
SAP-Agenten: Service and Maintenance Workload and Capacity Optimization Agent (LAB_PREVIEW), Service and Maintenance Dispatching Agent (LAB_PREVIEW), Field Service Dispatcher Agent (VERFUEGBAR), Joule in SAP FSM (Disponent) (VERFUEGBAR), Scheduling Policy Management Agent (LAB_PREVIEW), Resource Reservations Management Agent (LAB_PREVIEW), Autonomous Crew Planner/Manager Agent (LAB_PREVIEW), AI assisted Service Monitor (Operation Monitoring &amp; Resolution / Service Control Tower) (LAB_PREVIEW)
Objekte: Aktivität, Einsatz, Ressource
Apps: Planning &amp; Dispatching Board (FSM)
Scope Items: 49X
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f34</bpmn:incoming>
      <bpmn:outgoing>Flow_f35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="F04" name="Termin bestätigen &amp; Kunden informieren">
      <bpmn:documentation>Kunde erhält Termin bzw. ETA des Technikers.
Systeme: SAP Field Service Management, Kundenportal / Self-Service
SAP-Agenten: Journey Agent (LAB_PREVIEW), Service and Maintenance Dispatching Agent (LAB_PREVIEW)
Objekte: Termin
Hinweis: Standard-Kundenbenachrichtigung aus FSM bzw. Portal je Produkt prüfen.
Marker: Zu verifizieren</bpmn:documentation>
      <bpmn:incoming>Flow_f35</bpmn:incoming>
      <bpmn:outgoing>Flow_f36</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="F05" name="Einsatz vorbereiten (Briefing, Teile an Bord)">
      <bpmn:documentation>Techniker sichtet Auftrag, Historie, Besonderheiten beim Kunden und benötigte Teile.
Systeme: SAP Field Service Management
SAP-Agenten: Technician Briefing Agent (LAB_PREVIEW)
Objekte: Aktivität, Equipment-Historie
Apps: Field Service App (FSA)
Marker: Abgeleitet</bpmn:documentation>
      <bpmn:incoming>Flow_f36</bpmn:incoming>
      <bpmn:outgoing>Flow_f37</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="F06" name="Arbeit vor Ort durchführen &amp; dokumentieren">
      <bpmn:documentation>Durchführung mit der mobilen App: Checklisten (Smartforms), Zeiten, Material, Unterschrift des Kunden.
Systeme: SAP Field Service Management
SAP-Agenten: Work Execution Agent (LAB_PREVIEW)
Objekte: Aktivität, Checkliste, Zeitrückmeldung, Materialrückmeldung
Apps: Field Service App (FSA)
Scope Items: 49X
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f37</bpmn:incoming>
      <bpmn:outgoing>Flow_f38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="F07" name="Rückmeldung an S/4HANA (Servicerückmeldung)">
      <bpmn:documentation>FSM-Rückmeldung (Zeit, Spesen, Material) erzeugt die Servicerückmeldung in S/4HANA; Folgebelege für CO, Warenbewegung und Fakturaanforderung.
Systeme: SAP Field Service Management, SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Service Debriefing Agent (LAB_PREVIEW), Service Confirmation Agent (WIP)
Objekte: Servicerückmeldung
Scope Items: 49X
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f38</bpmn:incoming>
      <bpmn:outgoing>Flow_f39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="F08" name="Ersatz- und Altteile zurückführen">
      <bpmn:documentation>Nicht verbaute Ersatzteile bzw. Altteile werden ins Lager zurückgeführt (optional).
Systeme: SAP S/4HANA Logistik
SAP-Agenten: Service Parts Return Agent (LAB_PREVIEW)
Objekte: Rücklieferung, Umbuchung
Marker: Abgeleitet</bpmn:documentation>
      <bpmn:incoming>Flow_f39</bpmn:incoming>
      <bpmn:outgoing>Flow_f40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_BILL" name="">
      <bpmn:documentation>Zusammenführung In-House / Field Service
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f32</bpmn:incoming>
      <bpmn:incoming>Flow_f40</bpmn:incoming>
      <bpmn:outgoing>Flow_f41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_CHG" name="Kostenpflichtige Leistung?" default="Flow_f43">
      <bpmn:documentation>Garantie, Vertrag oder unreparierte Rücksendung führen zu keiner (oder nur einer Diagnose-)Faktura.
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f41</bpmn:incoming>
      <bpmn:outgoing>Flow_f42</bpmn:outgoing>
      <bpmn:outgoing>Flow_f43</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B01" name="Fakturaanforderung prüfen &amp; Faktura erstellen">
      <bpmn:documentation>Fakturaanforderung (Billing Document Request) prüfen und Faktura erzeugen; Festpreis aus dem Serviceauftrag oder aufwandsbezogen (bei Advanced Execution über DIP).
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Billing Orchestration Agent (LAB_PREVIEW)
Objekte: Fakturaanforderung, Faktura
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f42</bpmn:incoming>
      <bpmn:outgoing>Flow_f44</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B02" name="Kosten &amp; Erlöse abrechnen">
      <bpmn:documentation>Kosten und Erlöse in Controlling bzw. Ergebnisrechnung; bei positionsbezogener Kontierung Erlösrealisierung je Auftragsposition.
Systeme: SAP S/4HANA Service (Cloud ERP)
SAP-Agenten: Settlement Agent (LAB_PREVIEW)
Objekte: Kosten, Erlöse, Ergebnisrechnung
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f44</bpmn:incoming>
      <bpmn:outgoing>Flow_f45</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_DONE" name="">
      <bpmn:documentation>Zusammenführung
Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f43</bpmn:incoming>
      <bpmn:incoming>Flow_f45</bpmn:incoming>
      <bpmn:outgoing>Flow_f46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="C01" name="Case abschließen &amp; Kunden informieren">
      <bpmn:documentation>Case schließen, Kunde über Ergebnis informieren und Feedback einholen.
Systeme: SAP Service Cloud V2
SAP-Agenten: Journey Agent (LAB_PREVIEW)
Objekte: Case, Umfrage
Marker: Abgeleitet</bpmn:documentation>
      <bpmn:incoming>Flow_f46</bpmn:incoming>
      <bpmn:outgoing>Flow_f47</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="C02" name="Service auswerten: Qualität, Profitabilität, Folgegeschäft">
      <bpmn:documentation>Auswertung von Qualität, Profitabilität und Wiederholfehlern; Wissen sichern; Folgegeschäft (Austausch, Wartungsvertrag) anstoßen.
Systeme: SAP S/4HANA Service (Cloud ERP), SAP Service Cloud V2
SAP-Agenten: Knowledge Creation Agent (VERFUEGBAR), Knowledge Content Administration Agent (LAB_PREVIEW), Service Sales Agent (LAB_PREVIEW), Service Contract Lifecycle Renewal Agent (LAB_PREVIEW), Service Contract Performance Agent (LAB_PREVIEW), Maintenance Plan Creation Agent (LAB_PREVIEW), AI assisted Service Monitor (Operation Monitoring &amp; Resolution / Service Control Tower) (LAB_PREVIEW)
Objekte: Auswertung, Opportunity, Wartungsplan
Scope Items: 43B (Service Monitoring and Analytics)
Marker: Abgeleitet</bpmn:documentation>
      <bpmn:incoming>Flow_f47</bpmn:incoming>
      <bpmn:outgoing>Flow_f48</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="C03" name="Service abgeschlossen">
      <bpmn:documentation>Marker: SAP-Standard</bpmn:documentation>
      <bpmn:incoming>Flow_f48</bpmn:incoming>
    </bpmn:endEvent>
